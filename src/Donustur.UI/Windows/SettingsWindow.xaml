<Window x:Class="Donustur.UI.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LD Converter - Ayarlar"
        Width="600" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#12151E"
        Foreground="#FFFFFF"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#818CF8"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Koyu Tema ComboBox Stili -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E2333"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#312E81"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="Background" Value="#252B3D"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border"
                                                Background="#252B3D"
                                                BorderBrush="#3B4256"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#9CA3AF"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#6366F1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,6,28,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#1E2333"
                                            BorderBrush="#4F46E5"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,2,0,0">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Toggle Switch CheckBox Stili -->
        <Style x:Key="ModernSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="switchTrack" Width="42" Height="22" CornerRadius="11" Background="#374151" Padding="2">
                            <Ellipse x:Name="switchThumb" Width="18" Height="18" Fill="#D1D5DB" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="switchTrack" Property="Background" Value="#6366F1"/>
                                <Setter TargetName="switchThumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="switchThumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel>
            <!-- Başlık -->
            <TextBlock Text="Uygulama Ayarları" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
            <TextBlock Text="Sürükleme çarkını, çıktı hedeflerini ve dönüştürme motorlarını yapılandırın." FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,12"/>

            <!-- Çark & Sürükleme -->
            <TextBlock Text="Sürükleme &amp; Çark Davranışı" Style="{StaticResource SectionTitle}"/>
            <Border Background="#1A1E2B" BorderBrush="#262C3D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <!-- Aktif/Pasif -->
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Sürükleme Çarkı Etkin" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="Dosya sürüklerken seçilen tuşa basıldığında çark açılır." Style="{StaticResource SettingDesc}"/>
                        </StackPanel>
                        <CheckBox x:Name="EnableWheelCheck" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Separator Background="#2D3343" Margin="0,2,0,12"/>

                    <!-- Kısayol Tuşu -->
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Tetikleyici Tuş (Modifier)" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="Sürükleme anında basılı tutulacak klavye tuşu." Style="{StaticResource SettingDesc}"/>
                        </StackPanel>
                        <ComboBox x:Name="ModifierCombo" Style="{StaticResource DarkComboBox}" Width="140" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Shift"/>
                            <ComboBoxItem Content="Ctrl"/>
                            <ComboBoxItem Content="Alt"/>
                            <ComboBoxItem Content="Shift+Ctrl"/>
                        </ComboBox>
                    </DockPanel>

                    <Separator Background="#2D3343" Margin="0,2,0,12"/>

                    <!-- Çark Boyutu -->
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Çark Boyut Ölçeği" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="Radial menünün ekrandaki büyüklüğü." Style="{StaticResource SettingDesc}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ScaleValueLabel" Text="1.0x" FontSize="12" FontWeight="SemiBold" Foreground="#A5B4FC" Width="36" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="ScaleSlider" Width="130" Minimum="0.8" Maximum="1.4" Value="1.0" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" ValueChanged="OnScaleSliderChanged"/>
                        </StackPanel>
                    </DockPanel>

                    <Separator Background="#2D3343" Margin="0,2,0,12"/>

                    <!-- Ses Efektleri -->
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="Dokunsal Ses Geri Bildirimi" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="Dilimler arasında gezinirken ve işlem bitince ses çalar." Style="{StaticResource SettingDesc}"/>
                        </StackPanel>
                        <CheckBox x:Name="SoundCheck" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Çıktı Klasörü & Kalite -->
            <TextBlock Text="Çıktı &amp; Kalite Yönetimi" Style="{StaticResource SectionTitle}"/>
            <Border Background="#1A1E2B" BorderBrush="#262C3D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Kayıt Konumu" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="Dönüştürülen dosyaların kaydedileceği yer." Style="{StaticResource SettingDesc}"/>
                        </StackPanel>
                        <ComboBox x:Name="OutputModeCombo" Style="{StaticResource DarkComboBox}" Width="210" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="OnOutputModeChanged">
                            <ComboBoxItem Content="Kaynak Dosyayla Aynı Klasör"/>
                            <ComboBoxItem Content="Masaüstü"/>
                            <ComboBoxItem Content="Özel Klasör"/>
                        </ComboBox>
                    </DockPanel>

                    <!-- Özel Klasör Seçimi -->
                    <DockPanel x:Name="CustomFolderPanel" Margin="0,0,0,12" Visibility="Collapsed">
                        <Button Content="Gözat..." Width="75" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnBrowseFolderClick" Background="#374151" Foreground="#FFFFFF" BorderThickness="0" Padding="8,6" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                        </Button>
                        <TextBox x:Name="CustomFolderText" Background="#252B3D" Foreground="#FFFFFF" BorderBrush="#3B4256" Padding="8,5" VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <Separator Background="#2D3343" Margin="0,2,0,12"/>

                    <!-- Görsel Sıkıştırma Kalitesi -->
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Görsel Kalitesi (JPG / WebP / AVIF)" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="Yüksek değer daha iyi görüntü kalitesi, düşük değer daha küçük boyut sağlar." Style="{StaticResource SettingDesc}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="QualityValueLabel" Text="%85" FontSize="12" FontWeight="SemiBold" Foreground="#A5B4FC" Width="36" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="QualitySlider" Width="130" Minimum="20" Maximum="100" Value="85" SmallChange="5" LargeChange="10" VerticalAlignment="Center" ValueChanged="OnQualitySliderChanged"/>
                        </StackPanel>
                    </DockPanel>

                    <Separator Background="#2D3343" Margin="0,2,0,12"/>

                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="İşlem Sonrası Klasörü Aç" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="Dönüştürme bitince hedef dosyayı Windows Gezgini'nde gösterir." Style="{StaticResource SettingDesc}"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoOpenCheck" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Sistem & Başlangıç -->
            <TextBlock Text="Sistem Entegrasyonu" Style="{StaticResource SectionTitle}"/>
            <Border Background="#1A1E2B" BorderBrush="#262C3D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Kapatıldığında Sistem Tepsisinde Kal" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="Pencere kapandığında arka planda saat yanında çalışmaya devam eder." Style="{StaticResource SettingDesc}"/>
                        </StackPanel>
                        <CheckBox x:Name="MinimizeToTrayCheck" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Separator Background="#2D3343" Margin="0,2,0,12"/>

                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="Windows Başlangıcında Otomatik Başlat" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="Bilgisayar açıldığında LD Converter hazır bekler." Style="{StaticResource SettingDesc}"/>
                        </StackPanel>
                        <CheckBox x:Name="RunAtStartupCheck" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnStartupToggle"/>
                    </DockPanel>

                    <Separator Background="#2D3343" Margin="0,2,0,12"/>

                    <DockPanel>
                        <Button x:Name="CreateDesktopShortcutBtn" Content="🖥️ Masaüstü Kısayolu Ekle" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#2D3548" Foreground="#FFFFFF" BorderThickness="0" Padding="10,5" Cursor="Hand" Click="OnCreateDesktopShortcutClick">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Masaüstü Kısayolu" Style="{StaticResource SettingLabel}"/>
                            <TextBlock x:Name="DesktopShortcutStatusText" Text="Masaüstüne hızlı başlatma kısayolu oluşturun." Style="{StaticResource SettingDesc}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Harici Motor Durumu -->
            <DockPanel Margin="0,0,0,6">
                <Button x:Name="InstallAllMissingBtn" Content="⚡ Tüm Eksik Motorları Otomatik Kur" DockPanel.Dock="Right" Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Padding="10,5" Cursor="Hand" Click="OnInstallAllMissingClick">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>
                <TextBlock Text="Dönüştürme Motorları &amp; Durum" Style="{StaticResource SectionTitle}" Margin="0,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Background="#1A1E2B" BorderBrush="#262C3D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                <StackPanel>
                    <!-- FFmpeg -->
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="InstallFfmpegBtn" Content="📥 İndir &amp; Kur" Background="#4F46E5" Foreground="#FFFFFF" BorderThickness="0" Padding="10,5" Margin="0,0,6,0" Cursor="Hand" Click="OnInstallFfmpegClick">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="ffmpeg.exe Seç..." Background="#2D3548" Foreground="#FFFFFF" BorderThickness="0" Padding="10,5" Cursor="Hand" Click="OnBrowseFfmpegClick">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="FFmpeg (Video &amp; Ses Motoru)" Style="{StaticResource SettingLabel}"/>
                            <TextBlock x:Name="FfmpegStatusText" Text="Kontrol ediliyor..." Style="{StaticResource SettingDesc}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <Separator Background="#2D3343" Margin="0,4,0,10"/>

                    <!-- 7-Zip -->
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="Install7zBtn" Content="📥 Hızlı İndir" Background="#4F46E5" Foreground="#FFFFFF" BorderThickness="0" Padding="10,5" Margin="0,0,6,0" Cursor="Hand" Click="OnInstall7zClick">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="7z.exe Seç..." Background="#2D3548" Foreground="#FFFFFF" BorderThickness="0" Padding="10,5" Cursor="Hand" Click="OnBrowse7zClick">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="7-Zip (Yüksek Sıkıştırma Motoru)" Style="{StaticResource SettingLabel}"/>
                            <TextBlock x:Name="SevenZipStatusText" Text="Kontrol ediliyor..." Style="{StaticResource SettingDesc}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <Separator Background="#2D3343" Margin="0,4,0,10"/>

                    <!-- Pandoc -->
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="InstallPandocBtn" Content="📥 İndir &amp; Kur" Background="#4F46E5" Foreground="#FFFFFF" BorderThickness="0" Padding="10,5" Margin="0,0,6,0" Cursor="Hand" Click="OnInstallPandocClick">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="pandoc.exe Seç..." Background="#2D3548" Foreground="#FFFFFF" BorderThickness="0" Padding="10,5" Cursor="Hand" Click="OnBrowsePandocClick">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Pandoc &amp; XeLaTeX (Markdown &amp; Matematik Denklem Motoru)" Style="{StaticResource SettingLabel}"/>
                            <TextBlock x:Name="PandocStatusText" Text="Kontrol ediliyor..." Style="{StaticResource SettingDesc}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <Separator Background="#2D3343" Margin="0,4,0,10"/>

                    <!-- LibreOffice -->
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="InstallLibreOfficeBtn" Content="📥 Winget ile Kur" Background="#4F46E5" Foreground="#FFFFFF" BorderThickness="0" Padding="10,5" Margin="0,0,6,0" Cursor="Hand" Click="OnInstallLibreOfficeClick">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="soffice.exe Seç..." Background="#2D3548" Foreground="#FFFFFF" BorderThickness="0" Padding="10,5" Cursor="Hand" Click="OnBrowseLibreOfficeClick">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="LibreOffice (Gelişmiş Ofis Belgeleri Motoru)" Style="{StaticResource SettingLabel}"/>
                            <TextBlock x:Name="LibreOfficeStatusText" Text="Kontrol ediliyor..." Style="{StaticResource SettingDesc}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <Separator Background="#2D3343" Margin="0,4,0,10"/>

                    <!-- Dahili Yerel Motorlar -->
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="Dahili Motorlar (Magick.NET, PdfPig, PdfSharpCore, ZXing, SharpCompress)" Style="{StaticResource SettingLabel}"/>
                            <TextBlock x:Name="NativeEnginesStatusText" Text="✓ Görsel, PDF, DOCX, QR, ZIP ve TAR motorları %100 dahili ve hazır" Style="{StaticResource SettingDesc}" Foreground="#86EFAC"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Kaydet Butonu -->
            <Button Content="Ayarları Kaydet ve Kapat"
                    Height="40"
                    Background="#6366F1"
                    Foreground="#FFFFFF"
                    FontWeight="SemiBold"
                    FontSize="13.5"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnSaveClick">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Window>
