<Window x:Class="Donustur.UI.Windows.ProgressToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LD Converter"
        Width="350" Height="145"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual">
    <Border Background="#F2181C26"
            BorderBrush="#35FFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Başlık ve İptal/Kapat Butonu -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="TitleText"
                           Text="Dönüştürülüyor..."
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           Margin="0,0,24,0"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="CloseButton"
                        Content="✕"
                        ToolTip="İptal Et / Kapat"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        Foreground="#9CA3AF"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontSize="11.5"
                        Click="OnCloseClick" />
            </Grid>

            <!-- Durum Açıklaması -->
            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Text="Dosyalar işleniyor..."
                       FontSize="11.5"
                       Foreground="#9CA3AF"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,4,0,8" />

            <!-- İlerleme Çubuğu -->
            <ProgressBar x:Name="ProgressBar"
                         Grid.Row="2"
                         Height="5"
                         Minimum="0" Maximum="100"
                         Value="0"
                         Foreground="#6366F1"
                         Background="#2D3343"
                         BorderThickness="0" />

            <!-- İşlem Butonları (Tamamlandığında görünür) -->
            <StackPanel x:Name="ActionPanel"
                        Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                <Button x:Name="CopyTextButton"
                        Content="Metni Kopyala"
                        Visibility="Collapsed"
                        Background="#6366F1"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Padding="10,4"
                        Margin="0,0,6,0"
                        FontSize="11"
                        Cursor="Hand"
                        Click="OnCopyTextClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="OpenFolderButton"
                        Content="Klasörde Göster"
                        Background="#2D3343"
                        Foreground="#E0E7FF"
                        BorderThickness="0"
                        Padding="10,4"
                        FontSize="11"
                        Cursor="Hand"
                        Click="OnOpenFolderClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
