<Window x:Class="Donustur.UI.Windows.WheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Donustur.UI.Controls"
        Title="LD Converter Çarkı"
        Width="380" Height="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        AllowDrop="True"
        WindowStartupLocation="Manual">
    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="WheelScale" ScaleX="1.0" ScaleY="1.0" />
        </Grid.RenderTransform>

        <controls:RadialWheelControl x:Name="RadialControl"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
    </Grid>
</Window>
